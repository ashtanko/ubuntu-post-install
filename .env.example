# .env.example — copy to repo .env or ~/.env-ubuntu-post-install and edit.
# Scripts load it without automatically exporting config-only values.
# No value is required — scripts fall back to interactive prompts or sensible defaults.

# ── Your identity ──────────────────────────────────────────────────────────────
# Used by: git config (base.sh), GPG key generation (gpg.sh), SSH key (ssh.sh)
GIT_NAME="Your Full Name"
GIT_EMAIL="you@example.com"

# ── Git defaults ───────────────────────────────────────────────────────────────
# Used by: system/base.sh
GIT_DEFAULT_BRANCH="main"    # default branch name for new repos (main | master)
GIT_EDITOR="nano"            # commit message editor: nano | vim | code | nvim

# ── Installation paths ─────────────────────────────────────────────────────────
# Used by the respective dev/ scripts. Change if you prefer different locations.
FLUTTER_DIR="$HOME/development"   # where the Flutter SDK repo is cloned
NVM_DIR="$HOME/.nvm"              # NVM installation directory
PYENV_ROOT="$HOME/.pyenv"         # pyenv installation directory
GO_INSTALL_DIR="/usr/local/go"    # Go SDK extraction target (needs sudo)
# GO_ARCHIVE_URL=""               # custom archive; requires GO_ARCHIVE_SHA256
# GO_ARCHIVE_SHA256=""
# JAVA_VERSION="21"               # dev/java.sh — OpenJDK major: 8 | 11 | 17 | 21 | 25 (empty = interactive prompt)
# DOTNET_VERSION="8.0"             # dev/dotnet.sh — .NET SDK major.minor
# RBENV_ROOT="$HOME/.rbenv"        # dev/ruby.sh — rbenv installation directory
# RUBY_VERSION=""                  # dev/ruby.sh — pin a version; empty = latest stable
# PHP_VERSION="8.3"                # dev/php.sh — PHP major.minor from the ondrej/php PPA
# DENO_INSTALL="$HOME/.deno"       # dev/deno.sh — Deno installation directory
# BUN_INSTALL="$HOME/.bun"         # dev/bun.sh — Bun installation directory

# ── Feature flags ──────────────────────────────────────────────────────────────
INSTALL_OH_MY_ZSH="yes"           # tools/zsh.sh:    install Oh My Zsh? yes | no
INSTALL_FISHER="yes"              # tools/fish.sh:   install Fisher plugin manager? yes | no
SET_FISH_AS_DEFAULT="yes"         # tools/fish.sh:   make Fish the login shell? yes | no
INSTALL_DOCKER_DESKTOP="yes"      # dev/docker.sh:   install Docker Desktop GUI? yes | no

# ── Setup log ──────────────────────────────────────────────────────────────────
# SETUP_LOG_FILE="$HOME/ubuntu-setup.log"

# ── Essentials ─────────────────────────────────────────────────────────────────
# Used by essentials/*.sh
SWAP_SIZE_GB=4                       # essentials/swap.sh — swap file size in GB
# SWAP_FILE="/swapfile"
# FSTAB_FILE="/etc/fstab"
ENABLE_UFW="yes"                     # essentials/firewall.sh — yes | no
ENABLE_AUTO_UPDATES="yes"            # essentials/auto-updates.sh — yes | no
ENABLE_FAIL2BAN="yes"                # essentials/fail2ban.sh — yes | no
# FAIL2BAN_BANTIME="1h"              # essentials/fail2ban.sh — systemd-style duration
# FAIL2BAN_FINDTIME="10m"            # essentials/fail2ban.sh
# FAIL2BAN_MAXRETRY=5                # essentials/fail2ban.sh
TZ=""                                # essentials/locale-timezone.sh — auto-detect if empty
LOCALE="en_US.UTF-8"                 # essentials/locale-timezone.sh
# JOURNAL_MAX_USE="200M"             # essentials/journald.sh — systemd disk-size syntax: 200M | 1G | 10%
# INOTIFY_MAX_WATCHES=524288         # essentials/sysctl-limits.sh
# INOTIFY_MAX_INSTANCES=1024         # essentials/sysctl-limits.sh
# NOFILE_LIMIT=1048576               # essentials/sysctl-limits.sh — needs a new login session to take effect

# ── System ─────────────────────────────────────────────────────────────────────
# Used by system/*.sh
# NEW_HOSTNAME=""                    # system/hostname.sh — prompts if unset and interactive
# EXTRA_USER_GROUPS="docker dialout plugdev wireshark"   # system/user-groups.sh
# DNS_SERVERS="1.1.1.1 9.9.9.9"                           # system/hosts-dns.sh
# DNS_FALLBACK_SERVERS="1.0.0.1 149.112.112.112"          # system/hosts-dns.sh
# SUDO_TIMESTAMP_TIMEOUT_MINUTES=""  # system/sudoers.sh — opt-in only; minutes, -1 = never expire

# ── IDE / Editor ───────────────────────────────────────────────────────────────
# ide/vscode-extensions.sh — whitespace-separated extension IDs
VSCODE_EXTENSIONS="ms-python.python rust-lang.rust-analyzer dbaeumer.vscode-eslint esbenp.prettier-vscode"
# JETBRAINS_TOOLBOX_DIR="$HOME/.local/share/JetBrains/Toolbox"
# NVIM_INSTALL_DIR="$HOME/.local/share/nvim-stable"
# NVIM_ARCHIVE_URL=""              # custom archive; requires NVIM_ARCHIVE_SHA256
# NVIM_ARCHIVE_SHA256=""
# CURSOR_INSTALL_DIR="$HOME/.local/share/Cursor"   # ide/cursor.sh — where the AppImage is placed

# ── Apps ───────────────────────────────────────────────────────────────────────
# apps/postman.sh — where Postman is extracted (symlinked into ~/.local/bin)
# POSTMAN_INSTALL_DIR="$HOME/.local/share/Postman"

# ── Git / Dev helpers ──────────────────────────────────────────────────────────
ENABLE_GIT_COMMIT_SIGNING="no"       # tools/git-config.sh — flip after running system/gpg.sh
# GPG_KEY_ID=""                      # select one existing secret key explicitly

# ── Backup ─────────────────────────────────────────────────────────────────────
# tools/backup-home.sh
BACKUP_DIR="$HOME/backups"
BACKUP_ENCRYPT="no"                  # yes = gpg-encrypt the tarball
# BACKUP_GPG_RECIPIENT=""            # defaults to $GIT_EMAIL

# ── Dotfiles ───────────────────────────────────────────────────────────────────
# tools/dotfiles.sh — only clones the source dir; never auto-applies to $HOME
# DOTFILES_REPO=""                   # e.g. git@github.com:you/dotfiles.git

# ── VPN ────────────────────────────────────────────────────────────────────────
# vpn/tailscale.sh
# TAILSCALE_AUTHKEY=""               # non-interactive `tailscale up`; empty = manual login

# ── AI ─────────────────────────────────────────────────────────────────────────
# ai/prompt-runner.sh — selects which LLM the `prompt` CLI talks to
PROMPT_BACKEND="ollama"              # ollama | openai | anthropic
# PROMPT_MODEL=""                    # backend-specific default if empty
# OLLAMA_HOST="http://localhost:11434"
# OLLAMA_MODELS="qwen3:4b nomic-embed-text"   # ai/ollama-models.sh; downloads can be large
# CLAUDE_CHANNEL="stable"                     # stable | latest
# CODEX_RELEASE="latest"                      # latest or a release version
# COPILOT_VERSION="latest"                    # latest or a release version
# CLINE_VERSION="latest"                      # npm version or dist-tag
# MCP_INSPECTOR_VERSION="latest"               # npm version or dist-tag
# LLM_VERSION="latest"                        # PyPI version or latest
# LITELLM_VERSION="latest"                    # PyPI version or latest
OPENAI_API_KEY=""                    # required for -b openai
ANTHROPIC_API_KEY=""                 # required for -b anthropic
# LLAMA_CPP_DIR="$HOME/.local/src/llama.cpp"
